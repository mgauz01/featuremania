# --- Local live loop (required) ---
# GitHub OAuth App: homepage http://localhost:3000
# Authorization callback (the one that matters):
#   http://localhost:3000/api/auth/callback/github
# Copy GITHUB_ID, GITHUB_SECRET, NEXTAUTH_* and API_ORIGIN into apps/web/.env.local
# (Next.js does not load this repo-root file automatically.)

GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Required even in dev. Middleware redirects to Configuration error if empty.
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Next.js rewrite target for /v1/usage. The Otari key stays on the API.
# Native ./run.sh uses this localhost value. docker compose overrides it to
# http://api:8000 inside the web container only. Do not point the browser at api.
API_ORIGIN=http://localhost:8000

# Otari — required for preflight and for a successful board load.
OTARI_BASE_URL=https://api.otari.ai/v1
OTARI_API_KEY=
# Override if your workspace catalog differs.
OTARI_SUMMARY_MODEL=mzai:deepseek-ai/DeepSeek-V4-Pro
OTARI_CATEGORY_MODEL=mzai:deepseek-ai/DeepSeek-V4-Pro
OTARI_JUDGMENT_MODEL=mzai:deepseek-ai/DeepSeek-V4-Pro
OTARI_GUARDRAIL_PROFILE=prompt-injection
OTARI_GUARDRAIL_MODE=block
OTARI_BUDGET_USER=featuremania

# Public org catalogs merged into the picker ahead of personal/collab repos.
# Default is mozilla-ai. Comma-separated. No PAT; uses the SSO bearer.
GITHUB_ORG_LOGINS=mozilla-ai
# Local load cap (default 20, max 200). Each issue makes one Otari JSON call.
LIVE_MAX_ISSUES=20

# --- Unused for the one-SSO live loop ---
# Do not use a PAT for scrape. The signed-in GitHub token is forwarded by the BFF.
GITHUB_TOKEN=
# Leftover FastAPI OAuth at :8000. Not the Sign in on :3000.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# MCP client is a stub. Leave unset.
GITHUB_MCP_URL=
