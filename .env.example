# GitHub OAuth (Task 2 / Task 3)
# Register both Authorization callback URLs on the same GitHub OAuth app:
#   http://localhost:8000/auth/github/callback          (API, Task 2)
#   http://localhost:3000/api/auth/callback/github      (NextAuth, Task 3)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Same GitHub app credentials as GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
GITHUB_ID=
GITHUB_SECRET=

# GitHub API token for GraphQL fallback scraper (Task 5)
GITHUB_TOKEN=
# Optional. When unset, MCPClient stays disabled and scrape_repo uses GraphQL.
GITHUB_MCP_URL=

# Otari gateway (Task 7) — hosted otari.ai
OTARI_BASE_URL=https://api.otari.ai/v1
OTARI_API_KEY=gw-...
# Override if your workspace catalog differs. Defaults are from otari.ai docs (2026-08).
OTARI_SUMMARY_MODEL=mzai:deepseek-ai/DeepSeek-V3.2
OTARI_CATEGORY_MODEL=mzai:moonshotai/Kimi-K2.6
OTARI_JUDGMENT_MODEL=mzai:deepseek-ai/DeepSeek-V3.2
OTARI_GUARDRAIL_PROFILE=prompt-injection
OTARI_GUARDRAIL_MODE=block
# Hosted Otari attributes spend via extra_body.session_label (user is a no-op there).
# This value is sent as both session_label and the OpenAI user field.
OTARI_BUDGET_USER=featuremania

# Next.js rewrite target for /v1/usage (Task 10). The gateway stays backend-only.
API_ORIGIN=http://localhost:8000

# NextAuth (Task 3) — copy these into apps/web/.env.local
# (Next.js does not load this repo-root file automatically)
NEXTAUTH_URL=http://localhost:3000
# Required even in dev. Middleware redirects to Configuration error if empty.
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Production (Vercel frontend + Railway/Render API) ---
# Set these in the host dashboards. Do not commit real secrets or public URLs.
# Vercel: NEXTAUTH_URL, NEXTAUTH_SECRET, GITHUB_ID, GITHUB_SECRET, API_ORIGIN
# Railway/Render (.env / service variables): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
#   GITHUB_REDIRECT_URI, GITHUB_TOKEN, OTARI_API_KEY, OTARI_BASE_URL
# NEXTAUTH_URL=https://YOUR_VERCEL_HOST
# API_ORIGIN=https://YOUR_API_HOST
# GITHUB_REDIRECT_URI=https://YOUR_API_HOST/auth/github/callback
# Register both GitHub OAuth Authorization callback URLs on the same app:
#   https://YOUR_VERCEL_HOST/api/auth/callback/github
#   https://YOUR_API_HOST/auth/github/callback

