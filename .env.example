# GitHub OAuth (Task 2 / Task 3)
# Register both Authorization callback URLs on the same GitHub OAuth app:
#   http://localhost:8000/auth/github/callback          (API, Task 2)
#   http://localhost:3000/api/auth/callback/github      (NextAuth, Task 3)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Same GitHub app credentials as GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
GITHUB_ID=
GITHUB_SECRET=

# GitHub API token for GraphQL fallback scraper (Task 5)
GITHUB_TOKEN=
# Optional. When unset, MCPClient stays disabled and scrape_repo uses GraphQL.
GITHUB_MCP_URL=

# Otari gateway (Task 7)
OTARI_BASE_URL=http://localhost:8080/v1
OTARI_API_KEY=gw-...

# NextAuth (Task 3) — copy these into apps/web/.env.local
# (Next.js does not load this repo-root file automatically)
NEXTAUTH_URL=http://localhost:3000
# Required even in dev. Middleware redirects to Configuration error if empty.
#   openssl rand -base64 32
NEXTAUTH_SECRET=
